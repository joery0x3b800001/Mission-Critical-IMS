# ─── Development Environment (Default) ───────────────────────────────────
# Used automatically by docker-compose when running: docker-compose up

# Server Configuration
PORT=3001
NODE_ENV=development

# Worker Configuration
WORKER_CONCURRENCY=8

# Rate Limiting
RATE_LIMIT_MAX=10000
RATE_LIMIT_WINDOW_MS=10000
PER_IP_RATE_LIMIT_MAX=1000
PER_IP_RATE_LIMIT_WINDOW_MS=60000

# Signal Processing
BATCH_SIGNAL_MAX_SIZE=100
DEBOUNCE_WINDOW_MS=10000

# Queue Configuration
QUEUE_RETRY_ATTEMPTS=3
QUEUE_RETRY_DELAY_MS=500
QUEUE_JOB_RETENTION_SECONDS=3600

# Signal Validation
MAX_MESSAGE_LENGTH=500
MAX_ERROR_CODE_LENGTH=50
MAX_COMPONENT_ID_LENGTH=100
MAX_LATENCY_MS=60000

# API Configuration
DEFAULT_INCIDENTS_LIMIT=20
MAX_INCIDENTS_LIMIT=100
DEFAULT_SIGNALS_LIMIT=50
MAX_SIGNALS_LIMIT=500
INCIDENTS_LIST_CACHE_TTL=30
INCIDENT_DETAIL_CACHE_TTL=60

# Database
DB_POOL_MAX=50
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000

# RCA
RCA_MIN_TEXT_LENGTH=10

# Metrics
METRICS_INTERVAL_MS=5000

# WebSocket
WS_HEARTBEAT_INTERVAL_MS=30000
