# Mission-Critical IMS - Production Environment Configuration
# High Load: ~10M signals/day

# ══════════════════════════════════════════════════════════════════════════════
# HTTP & REQUEST HANDLING
# ══════════════════════════════════════════════════════════════════════════════

# Large body limit for high-volume batches
BODY_LIMIT_BYTES=5242880
BATCH_SIGNAL_MAX_SIZE=300

# ══════════════════════════════════════════════════════════════════════════════
# RATE LIMITING
# ══════════════════════════════════════════════════════════════════════════════

# High rate limit for production: 20x default
RATE_LIMIT_MAX=200000
RATE_LIMIT_WINDOW_MS=10000
PER_IP_RATE_LIMIT_MAX=10000
PER_IP_RATE_LIMIT_WINDOW_MS=60000

# ══════════════════════════════════════════════════════════════════════════════
# DEBOUNCING & QUEUEING
# ══════════════════════════════════════════════════════════════════════════════

DEBOUNCE_WINDOW_MS=10000
QUEUE_RETRY_ATTEMPTS=5
QUEUE_RETRY_DELAY_MS=500
QUEUE_JOB_RETENTION_SECONDS=1800

# ══════════════════════════════════════════════════════════════════════════════
# WORKER & CONCURRENCY
# ══════════════════════════════════════════════════════════════════════════════

# Production: 8x dev (assumes 32-core machine)
WORKER_CONCURRENCY=64

# ══════════════════════════════════════════════════════════════════════════════
# SIGNAL VALIDATION
# ══════════════════════════════════════════════════════════════════════════════

MAX_MESSAGE_LENGTH=1000
MAX_ERROR_CODE_LENGTH=100
MAX_COMPONENT_ID_LENGTH=255
MAX_LATENCY_MS=60000

# ══════════════════════════════════════════════════════════════════════════════
# PAGINATION & CACHING
# ══════════════════════════════════════════════════════════════════════════════

DEFAULT_INCIDENTS_LIMIT=50
MAX_INCIDENTS_LIMIT=200
DEFAULT_SIGNALS_LIMIT=50
MAX_SIGNALS_LIMIT=100

# Aggressive cache TTL for production (reduce DB load by 80%+)
INCIDENTS_LIST_CACHE_TTL=120
INCIDENT_DETAIL_CACHE_TTL=180

# ══════════════════════════════════════════════════════════════════════════════
# DATABASE CONNECTION POOL
# ══════════════════════════════════════════════════════════════════════════════

# Production: 1.5x worker concurrency (64 × 1.5 = 96, rounded to 100)
DB_POOL_MAX=150
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=20000

# ══════════════════════════════════════════════════════════════════════════════
# RCA CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════

RCA_MIN_TEXT_LENGTH=10

# ══════════════════════════════════════════════════════════════════════════════
# FRONTEND
# ══════════════════════════════════════════════════════════════════════════════

# Update these for your production domain
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
VITE_WS_BASE_RECONNECT_DELAY_MS=3000
VITE_WS_MAX_RECONNECT_DELAY_MS=60000
VITE_WS_MAX_RECONNECT_ATTEMPTS=20

# ══════════════════════════════════════════════════════════════════════════════
# PROFILE
# ══════════════════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=3001
